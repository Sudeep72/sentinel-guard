# SentinelGuard Dashboard — example environment configuration
# Copy to `.env` and fill in real values. Never commit `.env`.
#
# Real settings loading (pydantic-settings) lands in Phase 4.
# Listed here now so docker-compose.yml has a valid env_file target
# and so the "no hardcoded values" convention is visible from day one.

# --- Database ---
DATABASE_URL=sqlite:///./data/sentinelguard.db

# --- Auth ---
# Must be at least 32 bytes for HS256 (PyJWT warns below that length).
# Generate a real one with: python3 -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET_KEY=changeme-generate-a-real-secret-at-least-32-bytes-long
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=60

# --- Server ---
SENTINELGUARD_ENV=development
LOG_LEVEL=INFO

# --- Agent ingest auth ---
AGENT_API_KEY_HASH_ALGORITHM=bcrypt
